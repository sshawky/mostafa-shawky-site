# .htaccess for mostafa.shawky.info (LiteSpeed / Apache). Generated by build.py from deploy/htaccess.template.

# Never show raw directory listings (the old site exposed its file list at the root).
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. HTTPS + no www
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://mostafa.shawky.info%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.mostafa\.shawky\.info$ [NC]
RewriteRule ^ https://mostafa.shawky.info%{REQUEST_URI} [R=301,L]

# 2. Root: send visitors to their language (English if the browser prefers it, Arabic otherwise)
RewriteCond %{HTTP:Accept-Language} ^en [NC]
RewriteRule ^$ /en/ [R=302,L]
RewriteRule ^$ /ar/ [R=302,L]

# 3. Old 2003 FrontPage pages -> new pages (permanent)
RewriteRule ^Section1/Index1\.htm$ /ar/writings/preface/ [R=301,L,NC]
RewriteRule ^Section1/Index2\.htm$ /ar/writings/approach/ [R=301,L,NC]
RewriteRule ^Section1/Index3\.htm$ /ar/writings/influential-people/ [R=301,L,NC]
RewriteRule ^Section1/Index4\.htm$ /ar/writings/formative-influences/ [R=301,L,NC]
RewriteRule ^Section1/Index5\.htm$ /ar/writings/international-architects/ [R=301,L,NC]
RewriteRule ^Section1/Index6\.htm$ /ar/writings/exhibition-1990/ [R=301,L,NC]
RewriteRule ^Section1/Index7\.htm$ /ar/writings/other-interests/ [R=301,L,NC]
RewriteRule ^Section1/Index8\.htm$ /ar/writings/reflections/ [R=301,L,NC]
RewriteRule ^Section1/Index9\.htm$ /ar/writings/words-i-admired/ [R=301,L,NC]
RewriteRule ^Section1/Index10\.htm$ /ar/writings/happy-moments/ [R=301,L,NC]
RewriteRule ^Section2/Index1\.htm$ /ar/projects/canal-housing-society-tower/ [R=301,L,NC]
RewriteRule ^Section2/Index2\.htm$ /ar/projects/shawky-residence-dokki/ [R=301,L,NC]
RewriteRule ^Section2/Index3\.htm$ /ar/projects/safir-hotel/ [R=301,L,NC]
RewriteRule ^Section2/Index4\.htm$ /ar/projects/villa-baghdady/ [R=301,L,NC]
RewriteRule ^Section2/Index5\.htm$ /ar/projects/cairo-international-airport/ [R=301,L,NC]
RewriteRule ^Section2/Index6\.htm$ /ar/projects/cairo-hotel-tahrir/ [R=301,L,NC]
RewriteRule ^Section2/Index7\.htm$ /ar/projects/nasser-institute/ [R=301,L,NC]
RewriteRule ^Section2/Index8\.htm$ /ar/projects/yousri-gohar-hospital/ [R=301,L,NC]
RewriteRule ^Section2/Index9\.htm$ /ar/projects/philae-temples-salvage/ [R=301,L,NC]
RewriteRule ^Section2/Index10\.htm$ /ar/projects/benghazi-cultural-centre/ [R=301,L,NC]
RewriteRule ^Section2/Index11\.htm$ /ar/projects/african-development-bank/ [R=301,L,NC]
RewriteRule ^Section2/Index12\.htm$ /ar/projects/sheikh-zayed-palace/ [R=301,L,NC]
RewriteRule ^Section2/Index13\.htm$ /ar/projects/misr-dairy-plant/ [R=301,L,NC]
RewriteRule ^Section2/Index14\.htm$ /ar/projects/pyramids-desert-society/ [R=301,L,NC]
RewriteRule ^Section2/Index15\.htm$ /ar/projects/samaan-building-zamalek/ [R=301,L,NC]
RewriteRule ^Section2/Index16\.htm$ /ar/projects/villa-moharram-mohandessin/ [R=301,L,NC]
RewriteRule ^Section2/Index17\.htm$ /ar/projects/villa-moharram-mansouriya/ [R=301,L,NC]
RewriteRule ^Section3/Index1\.htm$ /ar/press/#al-mohandessin-1990 [R=301,L,NC,NE]
RewriteRule ^Section3/Index2\.htm$ /ar/press/#al-mussawar-1980 [R=301,L,NC,NE]
RewriteRule ^Section3/Index4\.htm$ /ar/press/#abdel-latif-el-baghdadi-1990 [R=301,L,NC,NE]
RewriteRule ^Section3/Index5\.htm$ /ar/press/#dr-moharram-1990 [R=301,L,NC,NE]
RewriteRule ^Section3/Index6\.htm$ /ar/press/#al-ahram-1968 [R=301,L,NC,NE]
RewriteRule ^Section3/Index7\.htm$ /ar/press/#honouring-the-creators-1991 [R=301,L,NC,NE]
RewriteRule ^Section3/Index8\.htm$ /ar/press/#al-memar-1991 [R=301,L,NC,NE]
RewriteRule ^Section3/Index9\.htm$ /ar/press/#october-1990 [R=301,L,NC,NE]
RewriteRule ^Section3/Index10\.htm$ /ar/press/#al-mussawar-1982 [R=301,L,NC,NE]
RewriteRule ^Section3/Index11\.htm$ /ar/press/#al-ahram-1970 [R=301,L,NC,NE]
RewriteRule ^Section3/Index12\.htm$ /ar/press/#tv-programme-2000 [R=301,L,NC,NE]
RewriteRule ^Section3/Index13\.htm$ /ar/press/#magdy-sabet-1989 [R=301,L,NC,NE]
RewriteRule ^Section3/Index14\.htm$ /ar/press/#cairo-municipality-letter-1958 [R=301,L,NC,NE]
RewriteRule ^Section1(/.*)?$ /ar/writings/ [R=301,L,NC]
RewriteRule ^Section2(/.*)?$ /ar/projects/ [R=301,L,NC]
RewriteRule ^Section3(/.*)?$ /ar/press/ [R=301,L,NC]
RewriteRule ^Section4(/.*)?$ /ar/writings/dedication/ [R=301,L,NC]
RewriteRule ^Thankyounote\.htm$ /ar/writings/dedication/ [R=301,L,NC]
RewriteRule ^(default2?\.html?|top[123]\.htm|Col[1-4]\.htm|index\.html?)$ /ar/ [R=301,L,NC]
RewriteRule ^(postinfo\.html|_vti_.*|_private/.*|cgi-bin/.*)$ - [G,L,NC]
</IfModule>

# Security headers
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(jpg|jpeg|png|svg|css|js|woff2?)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
<FilesMatch "\.pdf$">
Header set X-Robots-Tag "noindex"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
